{
  "name": "static-site-template",
  "description": "A static site template for The National Archives",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "lint": "prettier --check {src,.eleventy.js,README.md} && stylelint --config node_modules/@nationalarchives/frontend/config/stylelint.config.js 'src/css/**/*.scss' && eslint --config node_modules/@nationalarchives/frontend/config/.eslintrc.js 'src/js/**/*.{js,mjs}'",
    "lint:fix": "prettier --write {src,.eleventy.js,README.md} && stylelint --config node_modules/@nationalarchives/frontend/config/stylelint.config.js --fix 'src/css/**/*.scss' && eslint --config node_modules/@nationalarchives/frontend/config/.eslintrc.js --fix 'src/js/**/*.{js,mjs}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationalarchives/static-site-template.git"
  },
  "author": {
    "name": "Andrew Hosgood",
    "email": "andrew.hosgood@nationalarchives.gov.uk",
    "url": "https://andrewhosgood.dev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nationalarchives/static-site-template/issues"
  },
  "homepage": "https://github.com/nationalarchives/static-site-template#readme",
  "dependencies": {
    "@nationalarchives/frontend": "^0.20.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.1",
    "esbuild": "^0.25.5",
    "eslint": "^8.57.1",
    "markdown-it-class": "^1.0.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.2",
    "stylelint": "^16.20.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-selector-bem-pattern": "^4.0.1"
  }
}
