{
  "name": "static-site-template",
  "description": "A static site template for The National Archives",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "lint": "prettier --check {src,.eleventy.js,README.md} && stylelint --config stylelint.config.mjs 'src/css/**/*.scss' && eslint --config eslint.config.mjs 'src/js/**/*.{js,mjs}'",
    "lint:fix": "prettier --write {src,.eleventy.js,README.md} && stylelint --config stylelint.config.mjs --fix 'src/css/**/*.scss' && eslint --config eslint.config.mjs --fix 'src/js/**/*.{js,mjs}'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nationalarchives/static-site-template.git"
  },
  "author": {
    "name": "Andrew Hosgood",
    "email": "andrew.hosgood@nationalarchives.gov.uk",
    "url": "https://andrewhosgood.dev"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nationalarchives/static-site-template/issues"
  },
  "homepage": "https://github.com/nationalarchives/static-site-template#readme",
  "dependencies": {
    "@nationalarchives/frontend": "^1.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.1",
    "@nationalarchives/eslint-config": "^0.1.4",
    "@nationalarchives/stylelint-config": "^0.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.0",
    "markdown-it-class": "^1.0.0",
    "prettier": "^3.5.3",
    "sass": "^1.89.2"
  }
}
